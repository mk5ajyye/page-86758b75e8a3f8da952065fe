tion class=\"hero\">\n        <div class=\"hero-content\">\n            <div class=\"hero-text\">\n                <h1>YukiMo</h1>\n                <p>提供稳定高效的网络访问服务</p>\n            </div>\n            <div class=\"hero-visual\">\n                立即选择套餐\n            </div>\n        </div>\n    </section>\n    \n    <main>\n        <h2>机场套餐与客户端使用说明</h2>\n        \n        <section id=\"plans\" class=\"section\">\n            <h2>选择适合您的套餐</h2>\n            <div class=\"plans-grid\">\n                \n                <div class=\"plan-card\">\n                    <div class=\"plan-name\">基础版</div>\n                    <div class=\"plan-price\">¥15/月</div>\n                    <div class=\"plan-annual\">按年付仅需 ¥150/年</div>\n                    <ul class=\"plan-features\">\n                        <li>每月 100GB 极速流量</li>\n                        <li>支持 3 台设备同时在线</li>\n                        <li>解锁基础流媒体</li>\n                        <li>普通线路节点池</li>\n                    </ul>\n                </div>\n                \n                \n                <div class=\"plan-card featured\">\n                    <div class=\"plan-name\">旗舰版</div>\n                    <div class=\"plan-price\">¥35/月</div>\n                    <div class=\"plan-annual\">按年付仅需 ¥350/年</div>\n                    <ul class=\"plan-features\">\n                        <li>每月 300GB 极速流量</li>\n                        <li>支持 5 台设备同时在线</li>\n                        <li>全节点原生流媒体解锁</li>\n                        <li>IPLC 专线游戏加速优化</li>\n                        <li>7x24 优先工单支持</li>\n                    </ul>\n                </div>\n                \n                \n                <div class=\"plan-card\">\n                    <div class=\"plan-name\">团队版</div>\n                    <div class=\"plan-price\">¥85/月</div>\n                    <div class=\"plan-annual\">按年付仅需 ¥850/年</div>\n                    <ul class=\"plan-features\">\n                        <li>每月 1000GB 极速流量</li>\n                        <li>支持 20 台设备同时在线</li>\n                        <li>VIP 专属高带宽节点</li>\n                        <li>支持企业定制路由</li>\n                        <li>专属客户经理服务</li>\n                    </ul>\n                </div>\n            </div>\n        </section>\n        \n        <section id=\"client\" class=\"client-section\">\n            <h2>客户端下载与使用说明</h2>\n            <p>YukiMo 提供跨平台客户端，支持 Windows、macOS、iOS 及 Android 系统。</p>\n            <p>客户端采用轻量设计，可实现自动线路选择与流量实时监控。</p>\n            <p>安装完成后，请通过对应套餐选择最佳节点进行连接。</p>\n        </section>\n        \n        <section id=\"faq\" class=\"faq-section\">\n            <h2>常见问题解答</h2>\n            <details>\n                <summary>什么是 YukiMo？</summary>\n                <div class=\"answer\">\n                    <p>YukiMo 提供机场套餐和客户端服务，旨在帮助用户稳定访问网络资源。</p>\n                </div>\n            </details>\n            <details>\n                <summary>如何订阅套餐？</summary>\n                <div class=\"answer\">\n                    <p>选择适合的套餐并完成支付，即可立即使用对应权益。</p>\n                </div>\n            </details>\n            <details>\n                <summary>套餐如何计费？</summary>\n                <div class=\"answer\">\n                    <p>月付按月计算，年付可享优惠价格。</p>\n                </div>\n            </details>\n            <details>\n                <summary>客户端如何安装？</summary>\n                <div class=\"answer\">\n                    <p>根据您使用的操作系统下载对应版本客户端并运行。</p>\n                </div>\n            </details>\n            <details>\n                <summary>支持哪些设备？</summary>\n                <div class=\"answer\">\n                    <p>客户端支持 Windows、macOS、iOS 和 Android 平台。</p>\n                </div>\n            </details>\n            <details>\n                <summary>如何选择节点？</summary>\n                <div class=\"answer\">\n                    <p>登录客户端后可查看可用节点并选择最优线路。</p>\n                </div>\n            </details>\n        </section>\n    </main>\n    \n    <footer>\n        <div>\n            © 2025 YukiMo 网络服务\n        </div